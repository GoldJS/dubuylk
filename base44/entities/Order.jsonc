{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price_lkr": {
            "type": "number"
          },
          "price_aed": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "subtotal_lkr": {
      "type": "number"
    },
    "shipping_lkr": {
      "type": "number",
      "default": 0
    },
    "total_lkr": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "card",
        "bank_transfer",
        "cod"
      ]
    },
    "status": {
      "type": "string",
      "default": "pending"
    }
  },
  "required": [
    "order_number",
    "customer_name",
    "email",
    "phone",
    "address",
    "city",
    "items",
    "total_lkr",
    "payment_method"
  ]
}